# Copy to backend/.env and fill in. Never commit the real .env.

# Gemini key used by the LangGraph advisory agent
GOOGLE_API_KEY=

# Gemini key used by the chat assistant (falls back to GOOGLE_API_KEY if unset)
GOOGLE_CHAT_API_KEY=

# Optional: enables the RapidAPI Gemini fallback when the primary API fails.
# Leave empty to disable the fallback entirely.
RAPIDAPI_KEY=

# Optional: RSA private key (PKCS8 PEM, or base64-encoded PEM) used to sign
# audit attestations. If unset, backend/keys/private_key.pem is used, and if
# that is missing a throwaway key is generated at startup.
# Generate one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64
ATTESTATION_PRIVATE_KEY=
